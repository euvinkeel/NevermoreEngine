local roblox = require("@lune/roblox")
local function try(label, fn)
	local ok, res = pcall(fn)
	print(string.format("%-46s %s", label, if ok then "ok " .. tostring(res) else "FAIL " .. tostring(res):sub(1, 70)))
end
local Instance = roblox.Instance
try("Instance.new Folder", function() return Instance.new("Folder").ClassName end)
try("Parent / GetChildren / FindFirstChild", function()
	local a, b = Instance.new("Folder"), Instance.new("Model")
	b.Name = "Kid"; b.Parent = a
	return #a:GetChildren() .. " " .. tostring(a:FindFirstChild("Kid") == b)
end)
try("IsA / GetDescendants / Clone / Destroy", function()
	local a = Instance.new("Model"); local c = a:Clone(); c:Destroy(); return tostring(a:IsA("PVInstance")) .. " " .. #a:GetDescendants()
end)
try("Attributes Set/Get/GetAttributes", function()
	local a = Instance.new("Folder"); a:SetAttribute("Gold", 5); return a:GetAttribute("Gold") .. " " .. tostring(a:GetAttributes().Gold)
end)
try("Tags AddTag/HasTag/GetTags", function() local a = Instance.new("Folder"); a:AddTag("Enemy"); return tostring(a:HasTag("Enemy")) end)
try("IntValue.Value", function() local v = Instance.new("IntValue"); v.Value = 3; return v.Value end)
try("ObjectValue.Value", function() local v = Instance.new("ObjectValue"); v.Value = Instance.new("Folder"); return v.Value.ClassName end)
try("Changed event exists", function() return typeof(Instance.new("IntValue").Changed) end)
try("GetPropertyChangedSignal", function() return typeof(Instance.new("Folder"):GetPropertyChangedSignal("Name")) end)
try("ChildAdded event", function() return typeof(Instance.new("Folder").ChildAdded) end)
try("AttributeChanged / GetAttributeChangedSignal", function() return typeof(Instance.new("Folder"):GetAttributeChangedSignal("X")) end)
try("DataModel + GetService(Workspace)", function() local g = Instance.new("DataModel"); return g:GetService("Workspace").ClassName end)
try("GetService(RunService)", function() local g = Instance.new("DataModel"); return g:GetService("RunService").ClassName end)
try("RunService.Heartbeat", function() local g = Instance.new("DataModel"); return typeof(g:GetService("RunService").Heartbeat) end)
try("BindableEvent :Fire / .Event", function() local e = Instance.new("BindableEvent"); return typeof(e.Event) end)
for _, dt in { "Vector3", "Vector2", "CFrame", "Color3", "UDim2", "Enum", "Random", "DateTime", "NumberRange", "BrickColor", "TweenInfo" } do
	try("datatype " .. dt, function() return typeof((roblox :: any)[dt]) end)
end
try("Vector3.new math", function() return (roblox.Vector3.new(1, 2, 3) + roblox.Vector3.one).Magnitude end)
try("Enum.KeyCode.E", function() return tostring((roblox :: any).Enum.KeyCode.E) end)
